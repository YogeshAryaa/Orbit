NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
# Required in production; use the same Redis instance for every API/socket server
REDIS_URL=redis://localhost:6379
SESSION_PREFIX=chat:session:
# E2EE is enforced by default. Set false only for a deliberate legacy/plaintext migration.
E2EE_REQUIRED=true
BCRYPT_ROUNDS=12
MAX_UPLOAD_MB=20
OTP_TTL_MINUTES=10
RESET_TTL_MINUTES=15
# SMTP is required to deliver OTP/password reset email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMS provider integration should be added for phone OTP; no fake delivery is performed
# Cloudinary is recommended for durable production media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Web Push VAPID credentials (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
